---
import BaseLayout from './BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  readingMin: number;
}
const { title, description, pubDate, category, readingMin } = Astro.props;
const dateStr = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  articleSection: category,
  wordCount: readingMin * 220,
  inLanguage: 'en-US',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: {
    '@type': 'Person',
    name: 'Dr. Frazier A. Smith',
    url: 'https://vfrazier.app/about',
    sameAs: ['https://linkedin.com/in/fraziersmith'],
  },
  publisher: {
    '@type': 'Person',
    name: 'Dr. Frazier A. Smith',
    url: 'https://vfrazier.app',
  },
  image: 'https://vfrazier.app/og-default.png',
};
---
<BaseLayout title={`${title} — Frazier Smith`} description={description} current="writing">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} />
  <article class="post container">
    <header class="post-header cb-band">
      <a class="back" href="/writing">← All writing</a>
      <span class="cat cb-kicker">{category}</span>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
        <span aria-hidden="true">·</span>
        <span>{readingMin} min read</span>
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
    <footer class="post-footer">
      <p><strong>Written by Frazier Smith.</strong> Department chair at Central Piedmont, NSF co-PI, and AI &amp; IT educator. <a href="/about">More about me →</a></p>
    </footer>
  </article>

  <SubscribeForm />
</BaseLayout>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 0 var(--space-page-x) 60px; }
  .post-header { margin-bottom: 48px; padding: 36px 0 40px; }
  /* the band runs full-bleed, but the corner shapes would sit on the title in an 800px column */
  .post-header::before, .post-header::after { display: none; }
  .back { font-size: 13px; color: inherit; font-weight: 800; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .cat { display: table; margin: 22px 0 16px; }
  h1 { font-size: 48px; line-height: 1.05; font-weight: 900; letter-spacing: -.02em; margin-bottom: 14px; }
  .meta { font-size: 13px; color: inherit; display: flex; gap: 8px; font-weight: 600; }
  .post-footer {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 6px solid var(--coral);
    font-size: 14px;
    color: var(--ink-2);
  }
  .post-footer a { color: var(--violet); font-weight: 700; }
  @media (max-width: 720px) { h1 { font-size: 32px; } }
</style>
