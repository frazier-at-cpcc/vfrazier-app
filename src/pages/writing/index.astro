---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
function readingMin(body: string) {
  return Math.max(1, Math.round(body.trim().split(/\s+/).filter(Boolean).length / 220));
}
---
<BaseLayout title="Writing — Frazier Smith" current="writing">
  <header class="page-header cb-band">
    <div class="container">
      <span class="cb-kicker">Writing</span>
      <h1>Notes from the field.</h1>
      <p class="lede">Long-form posts on AI in the classroom, instructional design, and what enterprise L&amp;D and community colleges have to teach each other.</p>
      <a href="/rss.xml" class="rss">Subscribe via RSS</a>
    </div>
  </header>

  <section class="container list-wrap">
    {posts.length === 0 ? (
      <p class="empty">First post coming soon. <a href="/rss.xml">Subscribe via RSS</a> to be notified.</p>
    ) : (
      <div class="list">
        {posts.map((p) => (
          <PostRow
            date={formatDate(p.data.pubDate)}
            title={p.data.title}
            description={p.data.description}
            href={`/writing/${p.id}`}
            readingMin={readingMin(p.body ?? '')}
          />
        ))}
      </div>
    )}
  </section>

  <SubscribeForm />
</BaseLayout>

<style>
  .container { max-width: var(--container-max); margin: 0 auto; padding-left: var(--space-page-x); padding-right: var(--space-page-x); }
  .page-header { padding: 70px 0 40px; }
  h1 { font-size: 60px; line-height: 1.02; margin: 18px 0 18px; font-weight: 900; letter-spacing: -.025em; max-width: 17ch; }
  .lede { font-size: 17px; line-height: 1.55; max-width: 70ch; color: inherit; margin-bottom: 18px; }
  .rss { display: inline-block; font-size: 13px; background: var(--ink); color: var(--paper); font-weight: 800; padding: 9px 14px; }
  .rss:hover { background: var(--violet); color: var(--white); }
  .rss::after { content: ' ↗'; }
  .list-wrap { padding: 50px 0 80px; }
  .list { display: grid; gap: 6px; }
  .empty {
    padding: 32px 24px;
    background: var(--card);
    box-shadow: inset 0 0 0 2px var(--muted);
    text-align: center;
    color: var(--muted);
  }
  @media (max-width: 720px) { h1 { font-size: 40px; } }
</style>
