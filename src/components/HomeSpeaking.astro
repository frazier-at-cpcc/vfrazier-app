---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import SpeakingCard from './SpeakingCard.astro';
import SpeakerLogistics from './SpeakerLogistics.astro';

const topics = (await getCollection('speakingTopics'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

// Edge-to-edge mosaic: fills alternate so neighbors never share a color.
// A featured card overrides its slot with sun.
const fills = ['white', 'lilac', 'blush', 'mint'] as const;
---
<section class="section">
  <div class="inner">
    <SectionHead number="01" label="Speaking" title="Eight talks I give." moreLabel="See all topics" moreHref="/speaking" tone="sun" />
    <div class="grid">
      {topics.map((t, i) => (
        <SpeakingCard
          tag={t.data.tag}
          title={t.data.title}
          excerpt={t.body?.split('\n').filter(Boolean).slice(0, 1).join(' ') || t.data.abstract.split('\n')[0]}
          featured={t.data.featured}
          nsfFunded={t.data.nsfFunded}
          href={`/speaking#${t.id}`}
          fill={fills[i % fills.length]}
        />
      ))}
    </div>
    <SpeakerLogistics />
  </div>
</section>

<style>
  .section {
    padding: var(--space-section) 0;
    background: var(--violet);
    color: var(--white);
  }
  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-page-x);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
