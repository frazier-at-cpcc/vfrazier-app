---
import BrandMark from './BrandMark.astro';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="stripe" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="cols">
    <div class="col-brand">
      <div class="brand"><BrandMark size={52} /><span>frazier<span class="dot">.</span>smith</span></div>
      <p>AI &amp; IT educator. Learning design leader. Department chair at Central Piedmont. Speaker on the things in between.</p>
    </div>
    <div>
      <h5 class="h-sun">Site</h5>
      <ul>
        <li><a href="/speaking">Speaking</a></li>
        <li><a href="/writing">Writing</a></li>
        <li><a href="/talks">Talks</a></li>
        <li><a href="/teaching">Teaching</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </div>
    <div>
      <h5 class="h-teal">Elsewhere</h5>
      <ul>
        <li><a href="https://linkedin.com/in/fraziersmith" rel="noopener">LinkedIn</a></li>
        <li><a href="https://github.com/frazier-at-cpcc" rel="noopener">GitHub</a></li>
        <li><a href="https://sds.charlotte.edu/frazier-smith" rel="noopener">UNCC SDS profile</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
    <div>
      <h5 class="h-coral">Get in touch</h5>
      <ul>
        <li><a href="mailto:frazier@vfrazier.app">frazier@vfrazier.app</a></li>
        <li><a class="book" href="/speaking#book">Book a talk →</a></li>
      </ul>
    </div>
  </div>
  <div class="bar">
    <span>© {year} Frazier A. Smith · Charlotte, NC</span>
    <span>vfrazier.app</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--paper);
  }
  .stripe { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; height: 14px; }
  .stripe span:nth-child(1) { background: var(--violet); }
  .stripe span:nth-child(2) { background: var(--sun); }
  .stripe span:nth-child(3) { background: var(--coral); }
  .stripe span:nth-child(4) { background: var(--teal); }
  .cols {
    padding: 60px 40px 36px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 40px;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .col-brand .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 850;
    font-size: 22px;
    margin-bottom: 14px;
    letter-spacing: -.01em;
  }
  .col-brand .brand .dot { color: var(--sun); }
  .col-brand p { font-size: 13px; color: var(--footer-text); max-width: 280px; line-height: 1.55; }
  h5 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .12em;
    margin: 0 0 14px;
    font-weight: 800;
    display: inline-block;
    padding: 4px 8px;
    color: var(--ink);
  }
  .h-sun { background: var(--sun); }
  .h-teal { background: var(--teal); }
  .h-coral { background: var(--coral); }
  ul { list-style: none; }
  li { font-size: 13px; color: var(--footer-text); margin-bottom: 7px; font-weight: 500; }
  li a:hover { color: var(--ink); background: var(--sun); }
  .book { font-weight: 800; color: var(--sun); }
  .bar {
    padding: 18px 40px;
    border-top: 1px solid #3a3129;
    font-size: 11px;
    color: var(--footer-dim);
    display: flex;
    justify-content: space-between;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  @media (max-width: 720px) {
    .cols { grid-template-columns: 1fr 1fr; padding: 40px 20px 24px; gap: 28px; }
    .col-brand { grid-column: 1 / -1; }
    .bar { padding: 14px 20px; flex-direction: column; gap: 6px; }
  }
</style>
