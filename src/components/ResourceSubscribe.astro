---
// Email sign-up for new resource cards. Posts to functions/api/subscribe.ts, which adds the
// address to the Resend "Resource updates" audience. The notify-resources workflow emails it.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
---
<section class="subscribe" id="subscribe">
  <div class="inner">
    <span class="kicker"><i class="fa-solid fa-bell" aria-hidden="true"></i> Get notified</span>
    <h2>Hear about new resources.</h2>
    <p class="lede">One short email when a new resource is posted here. Nothing else. Every email has an unsubscribe link.</p>
    <p class="msg" id="subscribe-msg" role="status" hidden></p>
    <form class="form" method="POST" action="/api/subscribe">
      <label class="visually-hidden" for="rs-email">Email address</label>
      <input type="email" name="email" id="rs-email" required autocomplete="email" placeholder="you@example.com" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
      <button type="submit">Notify me →</button>
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
    </form>
  </div>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
  <script is:inline>
    (function () {
      var code = new URLSearchParams(location.search).get('subscribe');
      if (!code) return;
      var text = {
        ok: 'You are subscribed. The next new resource will arrive in your inbox.',
        email: 'That email address does not look right. Please check it and try again.',
        verification: 'The bot check did not pass. Please try again.',
      }[code] || 'The sign-up did not go through on my end (code: ' + code + '). Please try again later.';
      var msg = document.getElementById('subscribe-msg');
      msg.textContent = text;
      msg.className = 'msg ' + (code === 'ok' ? 'good' : 'bad');
      msg.hidden = false;
      history.replaceState(null, '', location.pathname + '#subscribe');
    })();
  </script>
</section>

<style>
  .subscribe { padding: var(--space-section) 0; background: var(--lilac); }
  .inner { max-width: 640px; margin: 0 auto; padding: 0 var(--space-page-x); text-align: center; }
  .kicker {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 800;
    color: var(--white); background: var(--violet); padding: 7px 12px;
  }
  h2 { font-size: 32px; font-weight: 800; letter-spacing: -.025em; margin: 18px 0 10px; line-height: 1.1; }
  .lede { font-size: 15px; line-height: 1.55; color: var(--ink-2); margin: 0 auto 22px; max-width: 56ch; }
  .form { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 460px; margin: 0 auto; }
  .form input[type='email'] {
    flex: 1; min-width: 0; border: 2px solid var(--ink); border-radius: var(--radius-sm);
    padding: 12px 14px; font-size: 14px; background: var(--card); font-weight: 500;
  }
  .form button {
    background: var(--violet); color: var(--white); border: 2px solid var(--violet);
    padding: 12px 20px; border-radius: var(--radius-sm); font-weight: 700; font-size: 14px;
    white-space: nowrap; cursor: pointer; transition: background-color .12s, border-color .12s;
  }
  .form button:hover { background: var(--ink); border-color: var(--ink); }
  .cf-turnstile { flex-basis: 100%; display: flex; justify-content: center; margin-top: 6px; }
  .msg { font-size: 14px; font-weight: 600; padding: 10px 14px; margin: 0 auto 16px; max-width: 460px; border: 2px solid var(--ink); background: var(--card); }
  .msg.bad { border-color: var(--coral); }
  .hp, .visually-hidden { position: absolute; clip: rect(0 0 0 0); width: 1px; height: 1px; overflow: hidden; }
  @media (max-width: 720px) {
    h2 { font-size: 26px; }
    .form { flex-direction: column; }
    .form button { width: 100%; }
  }
</style>
