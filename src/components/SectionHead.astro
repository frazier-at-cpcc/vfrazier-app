---
type Tone = 'violet' | 'sun' | 'coral' | 'teal' | 'ink' | 'paper';
interface Props {
  number: string;
  label: string;
  title: string;
  moreLabel?: string;
  moreHref?: string;
  /** Fill of the number block. Pick one that contrasts with the section band. */
  tone?: Tone;
}
const { number, label, title, moreLabel, moreHref, tone = 'ink' } = Astro.props;
const tones: Record<Tone, [string, string]> = {
  violet: ['var(--violet)', 'var(--white)'],
  sun: ['var(--sun)', 'var(--ink)'],
  coral: ['var(--coral)', 'var(--ink)'],
  teal: ['var(--teal)', 'var(--ink)'],
  ink: ['var(--ink)', 'var(--paper)'],
  paper: ['var(--paper)', 'var(--ink)'],
};
const [bg, fg] = tones[tone];
---
<div class="head">
  <span class="num" style={`background:${bg};color:${fg}`}>{number}</span>
  <div class="titles">
    <span class="label">{label}</span>
    <h2>{title}</h2>
  </div>
  {moreLabel && moreHref && <a class="more" href={moreHref}>{moreLabel}</a>}
</div>

<style>
  .head {
    display: flex;
    align-items: stretch;
    gap: 20px;
    margin-bottom: 40px;
    flex-wrap: wrap;
    color: inherit;
  }
  .num {
    width: 76px;
    min-height: 76px;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 0 0 6px 8px;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 900;
    font-size: 30px;
    line-height: 1;
    flex-shrink: 0;
  }
  .titles { display: flex; flex-direction: column; justify-content: flex-end; }
  .label {
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    font-weight: 800;
    margin-bottom: 6px;
  }
  h2 {
    font-size: 44px;
    margin: 0;
    font-weight: 900;
    letter-spacing: -.02em;
    line-height: 1;
  }
  .more {
    margin-left: auto;
    align-self: flex-end;
    font-size: 13px;
    font-weight: 800;
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    padding: 4px 6px;
  }
  .more::after { content: ' →'; }
  .more:hover { background: var(--ink); color: var(--paper); text-decoration: none; }
  @media (max-width: 720px) {
    .head { gap: 14px; }
    .num { width: 56px; min-height: 56px; font-size: 22px; }
    h2 { font-size: 30px; }
    .more { margin-left: 70px; }
  }
</style>
