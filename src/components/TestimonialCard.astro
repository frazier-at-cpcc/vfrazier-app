---
import HighlightPhrase from './HighlightPhrase.astro';

type Tone = 'violet' | 'coral' | 'teal' | 'sun';
interface Props {
  name: string;
  role: string;
  quote: string;
  highlightedPhrase?: string;
  initials: string;
  placeholder?: boolean;
  /** Color of the quote-mark block on the card's left edge. */
  tone?: Tone;
}
const { name, role, quote, highlightedPhrase, initials, placeholder = false, tone = 'violet' } = Astro.props;
---
<figure class:list={['card', `t-${tone}`, placeholder && 'placeholder']}>
  <span class="mark" aria-hidden="true">“</span>
  <div class="body">
    <blockquote class="quote">
      {highlightedPhrase ? <HighlightPhrase text={quote} phrase={highlightedPhrase} /> : quote}
    </blockquote>
    <figcaption class="attr">
      <span class="avatar">{initials}</span>
      <span class="who">
        <span class="name">{name}</span>
        <span class="role">{role}</span>
      </span>
    </figcaption>
  </div>
</figure>

<style>
  .card {
    display: grid;
    grid-template-columns: 64px 1fr;
    background: var(--white);
  }
  .t-violet { --t: var(--violet); --on: var(--white); }
  .t-coral { --t: var(--coral); --on: var(--ink); }
  .t-teal { --t: var(--teal); --on: var(--ink); }
  .t-sun { --t: var(--sun); --on: var(--ink); }
  .card.placeholder { background: transparent; box-shadow: inset 0 0 0 2px var(--muted); }
  .card.placeholder .mark { --t: var(--muted); }
  .mark {
    background: var(--t);
    color: var(--on);
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 72px;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    padding-top: 14px;
  }
  .body { padding: 26px 26px 22px; display: flex; flex-direction: column; }
  .quote {
    font-size: 15px;
    line-height: 1.6;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 20px;
    letter-spacing: -.005em;
  }
  .card.placeholder .quote { color: var(--muted); font-style: italic; }
  .attr {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--t);
    color: var(--on);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
  }
  .card.placeholder .avatar { background: #d6d0c6; color: transparent; }
  .who { display: flex; flex-direction: column; }
  .name { font-size: 13px; font-weight: 800; line-height: 1.25; }
  .role { font-size: 12px; color: var(--muted); font-weight: 600; margin-top: 1px; }
  @media (max-width: 480px) {
    .card { grid-template-columns: 44px 1fr; }
    .mark { font-size: 52px; }
    .body { padding: 20px 18px 18px; }
  }
</style>
