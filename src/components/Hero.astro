---
import { Image } from 'astro:assets';
import HighlightPhrase from './HighlightPhrase.astro';
import headshot from '../assets/headshot.jpg';
---
<section class="hero">
  <div class="hero-text">
    <span class="eyebrow">Dept Chair · NSF Co-PI · ex-VMware</span>
    <h1>
      From music<br />
      classroom to<br />
      <span class="hl">AI lab.</span>
    </h1>
    <p class="thesis">
      I study what AI is doing to <HighlightPhrase text="entry-level IT work" phrase="entry-level IT work" /> — and rebuild community-college curriculum around the answer.
    </p>
    <p class="lede">
      Department Chair of Network, Cybersecurity, and Cloud at Central Piedmont. Co-PI on the NSF GAIT grant building one of NC's first associate-degree AI programs. Graduate faculty at UNC Charlotte. Honors-program adjunct at Wingate.
    </p>

    <div class="ctas">
      <a href="/speaking#book" class="cta primary">Book me to speak →</a>
      <a href="/writing" class="cta secondary">Read recent writing</a>
    </div>

    <ul class="affil" aria-label="Affiliations">
      <li>Central Piedmont</li><li class="sq v" aria-hidden="true"></li>
      <li>UNC Charlotte</li><li class="sq c" aria-hidden="true"></li>
      <li>Wingate Honors</li><li class="sq t" aria-hidden="true"></li>
      <li>NSF ATE GAIT</li>
    </ul>
  </div>

  <div class="field">
    <div class="collage">
      <div class="photo">
        <Image src={headshot} alt="Dr. Frazier A. Smith" widths={[300]} sizes="300px" />
      </div>
      <span class="shape s1" aria-hidden="true"></span>
      <span class="shape s2" aria-hidden="true"></span>
      <span class="shape s3" aria-hidden="true"></span>
      <div class="focus">
        <span class="name">Dr. Frazier A. Smith</span>
        <span class="top">Research focus</span>
        AI × Entry-Level Workforce
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(440px, 40vw, 600px);
    border-bottom: 3px solid var(--ink);
  }
  .hero-text {
    padding: 72px 56px 72px max(var(--space-page-x), calc((100vw - var(--container-max)) / 2 + var(--space-page-x)));
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: .15em;
    text-transform: uppercase;
    margin-bottom: 22px;
    font-weight: 800;
    background: var(--ink);
    color: var(--paper);
    display: inline-block;
    padding: 6px 10px;
  }
  h1 {
    font-size: 62px;
    line-height: .98;
    margin: 0 0 26px;
    font-weight: 900;
    letter-spacing: -.025em;
  }
  h1 .hl {
    background: var(--violet);
    color: var(--white);
    padding: 0 10px 2px;
    display: inline-block;
    margin-top: 8px;
  }
  .thesis {
    font-size: 22px;
    line-height: 1.35;
    margin: 0 0 18px;
    font-weight: 600;
    letter-spacing: -.015em;
    max-width: 600px;
  }
  .lede {
    font-size: 16px;
    line-height: 1.55;
    margin-bottom: 30px;
    color: var(--ink-2);
    max-width: 600px;
  }
  .ctas { display: flex; gap: 0; margin-bottom: 30px; flex-wrap: wrap; }
  .cta {
    padding: 16px 24px;
    font-size: 14px;
    font-weight: 800;
    transition: background-color .12s, color .12s;
  }
  .cta.primary { background: var(--violet); color: var(--white); }
  .cta.secondary { background: var(--coral); color: var(--ink); }
  .cta:hover { background: var(--ink); color: var(--paper); }

  .affil {
    display: flex;
    gap: 14px;
    font-size: 11px;
    color: var(--muted);
    flex-wrap: wrap;
    align-items: center;
    font-weight: 700;
    list-style: none;
  }
  .affil .sq { width: 8px; height: 8px; }
  .sq.v { background: var(--violet); }
  .sq.c { background: var(--coral); }
  .sq.t { background: var(--teal); }

  /* Right side: a full-bleed sun field holding a block collage */
  .field {
    background: var(--sun);
    display: flex;
    align-items: flex-end;
    padding: 56px 0 0 48px;
  }
  .collage {
    display: grid;
    grid-template-columns: 300px 100px;
    grid-template-rows: repeat(3, 150px) auto;
  }
  .photo { grid-area: 1 / 1 / 4 / 2; background: var(--ink); }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .shape { position: relative; overflow: hidden; }
  .shape::before { content: ''; position: absolute; }
  /* coral cell, paper quarter circle hinged on the top-right corner */
  .s1 { background: var(--coral); }
  .s1::before { inset: 0; background: var(--paper); border-radius: 0 0 0 100%; }
  /* teal cell, paper half circle rising from the bottom */
  .s2 { background: var(--teal); }
  .s2::before { left: 0; right: 0; bottom: 0; height: 50%; background: var(--paper); border-radius: 999px 999px 0 0; }
  /* violet cell, sun circle */
  .s3 { background: var(--violet); }
  .s3::before { width: 62%; aspect-ratio: 1; top: 50%; left: 50%; transform: translate(-50%, -50%); background: var(--sun); border-radius: 50%; }

  .focus {
    grid-column: 1 / -1;
    background: var(--ink);
    color: var(--paper);
    padding: 16px 18px 18px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 17px;
    line-height: 1.2;
  }
  .focus .name {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    color: var(--footer-text);
    margin-bottom: 10px;
    letter-spacing: .02em;
  }
  .focus .top {
    display: block;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--sun);
    margin-bottom: 4px;
  }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; }
    .hero-text { padding: 44px var(--space-page-x) 40px; }
    h1 { font-size: 46px; }
    .field { padding: 40px var(--space-page-x) 0; justify-content: flex-start; }
    .collage {
      width: 100%;
      max-width: 400px;
      grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
      grid-template-rows: repeat(3, auto) auto;
    }
    .photo { aspect-ratio: 2 / 3; }
  }
  @media (max-width: 420px) {
    h1 { font-size: 40px; }
    .thesis { font-size: 20px; }
    .cta { flex: 1 1 auto; text-align: center; }
  }
</style>
